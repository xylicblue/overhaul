# Public frontend configuration injected by Vite at build time.
# The Supabase anon key is designed for browser use; never put the service-role
# key or any provider secret in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
VITE_API_GATEWAY_URL=https://YOUR_PRODUCTION_GATEWAY

# Temporary Trade-page demo mode. Set to false to restore all tradable markets.
# This does not change the landing page, Markets page, contracts or index data.
VITE_TRADE_H100_ONLY=true

# Optional Railway/API service used only for market-stat fallbacks.
# VITE_MARKET_STATS_API_URL=https://YOUR_MARKET_STATS_SERVICE

# Do not put SCORECHAIN_API_KEY or SCORECHAIN_PUBLIC_KEY in this frontend file.
# Configure both as server-side Supabase Edge Function secrets. The public key
# must be the current PEM key supplied by Scorechain; literal \n separators are
# accepted by the entity-wallet-screening function.
