# Required: production Supabase service credentials. Never expose the key to a browser.
SUPABASE_URL=https://basxvmmtxwlxylpukqjj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Required: chain and audited ClearingHouse deployment observed by this worker.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
CLEARING_HOUSE_ADDRESS=0xDf4DDD4019097B335dD507f916984A1A53E40a0d
COLLATERAL_TOKEN_ADDRESS=0x947Cc17D8CbC0Fc1E64de138eE4947d3AF9C26EE

# Required: first block from which this deployment should scan.
# Confirm the deployment block before production use.
START_BLOCK=0

# Runtime safety and throughput.
FINALITY_CONFIRMATIONS=12
BLOCK_CHUNK_SIZE=1000
POLL_INTERVAL_MS=15000
LEASE_SECONDS=60
RETRY_DELAY_MS=10000
RISK_REFRESH_INTERVAL_MS=900000
RISK_REFRESH_BATCH_SIZE=50
MARKET_CONFIG_PATH=./config/markets.sepolia.json
COLLATERAL_DECIMALS=6
PORT=8080

# Optional operational identity.
WORKER_NAME=entity-live-monitoring
INSTANCE_ID=
RUN_ONCE=false
DRY_RUN=false
